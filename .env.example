# Konfigurasi BACKEND (jalan di PC on-prem). Salin ke .env; berkas .env diabaikan git.
# Buat otomatis dengan kunci acak:  npm run init:env      Periksa:  npm run check:env
# Frontend di Vercel TIDAK membutuhkan variabel apa pun; semua rahasia (termasuk kunci Anthropic) hanya ada di PC ini.

# ---- Wajib ----
APP_SECRET=
PUBLIC_URL=https://NAMA-PROYEK.vercel.app

# ---- Jaringan ----
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1
RATE_LIMIT_PER_MIN=3000
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MIN=15

# ---- Data awal ----
# SEED_DEMO=1: muat data simulasi + akun demo (kata sandi lestari123; SIAPA SAJA bisa masuk bila URL publik).
# SEED_DEMO=0: mulai kosong; satu super admin dibuat dari ADMIN_EMAIL / ADMIN_PASSWORD.
SEED_DEMO=1
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Super Admin
# DEMO_MODE=1 mengaktifkan alat demo "ubah data event" (untuk presentasi integritas). Matikan di situs publik.
DEMO_MODE=0

# ---- AI (Anthropic) ----
# Kosong = ringkasan dan asisten memakai jawaban berbasis aturan.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Batas pertanyaan asisten per pengguna per menit. Turunkan bila URL publik (biaya).
AI_RATE_PER_MIN=5

# ---- Tunnel agar Vercel bisa menjangkau backend di PC ini (dipakai tombol OperasionalNyalakan-LestariPangan.bat) ----
# LP_TUNNEL: cloudflared (disarankan bila punya domain di Cloudflare) | tailscale (Funnel, tanpa domain) | ssh (butuh server perantara) | none
LP_TUNNEL=none
# cloudflared: token dari Cloudflare Zero Trust > Networks > Tunnels (hostname publik diarahkan ke http://127.0.0.1:3000 di dasbor)
# LP_CF_TUNNEL_TOKEN=
# ssh saja:
# LP_VPS_HOST=user@host
# LP_SSH_KEY=C:/kunci/kunci.pem
# LP_REMOTE_PORT=13400
# Alamat publik backend (untuk Status-LestariPangan.bat dan npm run vercel:config)
# LP_API_PUBLIC_URL=https://lestari-api.contoh.id

# ---- Opsional ----
# LP_DATA_DIR=D:\lestari-data
# MONGODB_URI=
# LEDGER_ADAPTER=local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# LOG=0
